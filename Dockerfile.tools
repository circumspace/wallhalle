# Fetch-and-derive image for the cluster job. Carries the content pages
# (they hold the source URLs), the config and the scripts, plus vips,
# yq and curl. It runs scripts/cluster-sync.sh against a volume and
# leaves cuts and originals there for the site image's nginx.
#
# uid 101 matches the nginx-unprivileged user in the site image, so files
# written here are readable there without fsGroup, which local-path
# volumes do not apply anyway.
FROM alpine:3.22
RUN apk add --no-cache vips-tools libqrencode-tools yq curl \
 && adduser -D -u 101 -h /app app
WORKDIR /app
COPY --chown=101:101 content/ content/
COPY --chown=101:101 config/ config/
COPY --chown=101:101 scripts/ scripts/
COPY --chown=101:101 bundled/ bundled/
USER 101
ENTRYPOINT ["scripts/cluster-sync.sh"]
